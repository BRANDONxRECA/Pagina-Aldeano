# Copiar a .env (no se sube al repositorio). Solo configuración y REFERENCIAS, nunca valores secretos.
SECRETS_DIR=./secrets            # carpeta con un archivo por referencia (ver docs/rutas-y-secretos.md)
DB_HOST=127.0.0.1
DB_PORT=3306
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RESERVATION_MINUTES=15
DELIVERY_FEE_CLP=0
RATE_DEFAULT=120                 # solicitudes por minuto por usuario/IP
RATE_AUTH=10
RATE_GRAPHQL=60
FRONTEND_ORIGIN=                 # ej. http://localhost (CORS, solo si se conecta un frontend)
GRAPHQL_INTROSPECTION=0
EXPOSE_DOCS=0                    # 1 = publica /docs (OpenAPI) de cada servicio en desarrollo
PROVIDER_URL=http://127.0.0.1:8009
